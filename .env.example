# Which vector store: supabase (web) or chroma (local, no keys needed)
STORE=chroma

# Web mode (Supabase + Voyage). Names only; values live in .env and Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VOYAGE_API_KEY=
SF_PASSCODE=

# Optional: slide descriptions (Claude Haiku 4.5)
ANTHROPIC_API_KEY=

# Loading phase 1 data and the private eval set (build machine only)
LECTURE_ARCHIVE=~/Lecture Archive
FT_EVAL_PATH=~/Code/faculty-twin/evals/questions.course.jsonl
SF_OPEN=            # set to 1 to run without the passcode
